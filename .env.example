# 🍪 Mirra Cookies - Environment Configuration
# Copy this to .env and fill in your actual values

# ============================================================================
# EMAIL CONFIGURATION (GMAIL EXAMPLE)
# ============================================================================
# Gmail Setup:
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Generate App Password: myaccount.google.com/apppasswords
# 3. Copy the 16-character password below

MIRRA_EMAIL=seu-email@gmail.com
MIRRA_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Alternative for Outlook:
# MIRRA_EMAIL=seu-email@outlook.com
# MIRRA_EMAIL_PASSWORD=sua-senha-outlook

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
DEBUG=False
SECRET_KEY=mirra-secret-2026-change-in-production
ADMIN_PASSWORD=mirra_admin_2024

# ============================================================================
# PAYMENT GATEWAY (Optional - for future integration)
# ============================================================================
STRIPE_API_KEY=sk_test_your_stripe_key_here
MERCADOPAGO_TOKEN=your_mercadopago_token_here

# ============================================================================
# DATABASE
# ============================================================================
# Default: SQLite (no configuration needed)
# Database file will be created at: database/mirra_cookies.db

# ============================================================================
# SECURITY
# ============================================================================
# Min password length: 8 characters
# Requires: 1 Uppercase, 1 Number, 1 Special Character
# Recovery code expires in: 15 minutes
# Session timeout: 30 minutes
# Max login attempts: 5 (then lockout for 15 minutes)
